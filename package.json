{
  "name": "beacon-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:waypoint": "npm run dev --workspace=waypoint",
    "build": "npm run build --workspaces --if-present",
    "build:waypoint": "npm run build --workspace=waypoint",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0"
  }
}
